diff --git a/flash_rl/agents/flashSAC/network.py b/flash_rl/agents/flashSAC/network.py
index 7ce086d..5a43ed1 100644
--- a/flash_rl/agents/flashSAC/network.py
+++ b/flash_rl/agents/flashSAC/network.py
@@ -56,6 +56,53 @@ class FlashSACActor(nn.Module):
         return actions, info
 
 
+class FlashSACMLPActor(nn.Module):
+    """
+    Configurable MLP actor trunk:
+    obs -> hidden_dims[0] -> ... -> hidden_dims[-1] -> policy head.
+    """
+
+    def __init__(
+        self,
+        input_dim: int,
+        hidden_dims: list[int],
+        action_dim: int,
+    ):
+        super().__init__()
+        if len(hidden_dims) == 0:
+            raise ValueError("hidden_dims must be non-empty for FlashSACMLPActor")
+
+        layers: list[nn.Module] = []
+        d_in = input_dim
+        for d_out in hidden_dims:
+            layers.append(nn.Linear(d_in, d_out))
+            layers.append(nn.ReLU(inplace=True))
+            d_in = d_out
+        self.trunk = nn.Sequential(*layers)
+        self.post_norm = UnitRMSNorm(d_in)
+        self.predictor = NormalTanhPolicy(hidden_dim=d_in, action_dim=action_dim)
+
+    def get_mean_and_std(
+        self,
+        observations: torch.Tensor,
+        training: bool,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        x = self.trunk(observations)
+        x = self.post_norm(x)
+        mean, std = self.predictor.get_mean_and_std(x, training)
+        return mean, std
+
+    def forward(
+        self,
+        observations: torch.Tensor,
+        training: bool,
+    ) -> tuple[torch.Tensor, dict[str, torch.Tensor]]:
+        x = self.trunk(observations)
+        x = self.post_norm(x)
+        actions, info = self.predictor(x, training)
+        return actions, info
+
+
